rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    //  Хелперы
    //
    //  ВАЖНО: get() по несуществующему документу роняет всю проверку, поэтому
    //  каждый get() прикрыт exists(). Логические && и || вычисляются лениво —
    //  порядок условий подобран так, чтобы обычный запрос стоил один exists().
    //  Лимит Firestore — 10 обращений к документам на одну проверку.
    // ═══════════════════════════════════════════════════════════════════════

    function uid()      { return request.auth.uid; }
    function signedIn() { return request.auth != null; }

    function profilePath(cid) {
      return /databases/$(database)/documents/userProfiles/$(cid + '_' + uid());
    }

    // Профиль в конкретном центре. Ключ композитный — userProfiles/{centerId}_{uid} —
    // поэтому членство проверяется одним exists() без запроса.
    function hasProfileIn(cid) { return exists(profilePath(cid)); }
    function profileIn(cid)    { return get(profilePath(cid)).data; }

    // Легаси-профиль с плоским ключом userProfiles/{uid}.
    // AuthContext.loadProfile мигрирует такие документы на композитный ключ при чтении.
    function legacyPath() {
      return /databases/$(database)/documents/userProfiles/$(uid());
    }

    function hasLegacyIn(cid) {
      return exists(legacyPath()) && get(legacyPath()).data.centerId == cid;
    }

    // Сотрудник платформы живёт на псевдо-центре "platform" (/setupforadmin2011).
    // Флаг isadm у владельца обычного центра прав платформы НЕ даёт — ср. isPlatformAdmin().
    function platformAdmin() {
      return signedIn()
             && hasProfileIn('platform')
             && profileIn('platform').isadm == true;
    }

    function platformUser() {
      return signedIn()
             && hasProfileIn('platform')
             && (profileIn('platform').isadm == true || profileIn('platform').ismod == true);
    }

    // Сеть филиалов: владелец сети и ПЕРСОНАЛ головного центра работают с филиалами.
    // Только staff HQ-центра получает сетевой доступ (учителя и студенты — нет).
    function networkIdOf(cid) {
      return exists(/databases/$(database)/documents/centers/$(cid))
             ? get(/databases/$(database)/documents/centers/$(cid)).data.get('networkId', '')
             : '';
    }

    function networkAccess(cid) {
      let nid = networkIdOf(cid);
      let netPath = /databases/$(database)/documents/networks/$(nid);
      let hqCid = get(netPath).data.headquartersCenterId;
      return nid != ''
             && exists(netPath)
             && (get(netPath).data.ownerId == uid()
                 || (hasProfileIn(hqCid)
                     && profileIn(hqCid).role in ['owner', 'director', 'administrator']));
    }

    // ─── Членство в центре ────────────────────────────────────────────────
    // Дёшево в типичном случае: свой центр — один exists().
    // networkAccess проверяется последним: он дороже всего по обращениям к документам.
    function member(cid) {
      return signedIn()
             && (hasProfileIn(cid) || hasLegacyIn(cid) || platformAdmin() || networkAccess(cid));
    }

    function roleIn(cid) {
      return hasProfileIn(cid)
             ? profileIn(cid).role
             : (exists(legacyPath()) ? get(legacyPath()).data.role : '');
    }

    function staff(cid) {
      return signedIn()
             && (roleIn(cid) in ['owner', 'director', 'administrator'] || platformAdmin());
    }

    function teacher(cid) {
      return signedIn()
             && (roleIn(cid) in ['owner', 'director', 'administrator', 'teacher'] || platformAdmin());
    }

    function owner(cid) {
      return signedIn() && (roleIn(cid) == 'owner' || platformAdmin());
    }

    // Допустимые роли — для валидации при создании профиля.
    function isValidRole(role) {
      return role in ['owner', 'director', 'administrator', 'teacher', 'student', 'parent'];
    }

    // Поля, которые пользователь не может назначить себе сам.
    // Без этого учитель делает updateDoc({ role: 'owner' }) и повышает себя.
    function noPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'isadm', 'ismod', 'centerId', 'id']);
    }

    function noPlatformFlags() {
      return request.resource.data.get('isadm', false) != true
             && request.resource.data.get('ismod', false) != true;
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Публичные коллекции (читаются до/без авторизации)
    // ═══════════════════════════════════════════════════════════════════════

    // Индекс username → email (вход по нику). Читается до логина.
    // create: email в документе ДОЛЖЕН совпадать с email автора — иначе
    // можно захватить чужой username, привязав его к подставному email.
    match /userLogins/{key} {
      allow read:   if true;
      allow create: if signedIn()
                    && request.resource.data.get('email', '') == request.auth.token.email;
      allow update: if platformUser()
                    || (signedIn() && resource.data.get('email', '') == request.auth.token.email);
      allow delete: if platformUser()
                    || (signedIn() && resource.data.get('email', '') == request.auth.token.email);
    }

    // Субдомены — нужны до логина для определения тенанта.
    // create: только владелец центра может привязать субдомен.
    // update/delete: только владелец этого центра или платформа.
    match /subdomains/{subdomain} {
      allow read:   if true;
      allow create: if signedIn()
                    && request.resource.data.get('centerId', '') != ''
                    && owner(request.resource.data.get('centerId', ''));
      allow update: if platformAdmin()
                    || owner(resource.data.get('centerId', ''));
      allow delete: if platformAdmin()
                    || owner(resource.data.get('centerId', ''));
    }

    match /platformConfig/{docId} {
      // publicMeta = { initialized: true } — читается без авторизации в SetupAdminPage
      allow read:  if docId == 'publicMeta' || signedIn();
      // publicMeta: только create (один раз при инициализации), update/delete — только platformAdmin.
      // Это закрывает race condition: нельзя удалить publicMeta и пересоздать admin.
      allow create: if platformAdmin()
                    || (docId == 'publicMeta' && signedIn());
      allow update, delete: if platformAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Центры и данные тенанта
    // ═══════════════════════════════════════════════════════════════════════

    match /centers/{centerId} {
      // Документ центра публичен: LoginPage берёт брендинг до авторизации.
      allow read: if true;
      // Регистрация создаёт центр ДО профиля владельца — профиля ещё не существует.
      // Валидация: ownerEmail ДОЛЖЕН совпадать с email создателя.
      allow create: if signedIn()
                    && request.resource.data.get('ownerEmail', '') == request.auth.token.email;
      allow update: if staff(centerId);
      allow delete: if owner(centerId);

      // ─── Данные тенанта: разделение по ролям ────────────────────────────
      // Читать могут все member'ы центра.
      // Писать (create/update/delete) — только персонал (staff).
      // Это закрывает уязвимость: студент/учитель/родитель больше не могут
      // удалять или изменять комнаты, курсы, группы и т.д.

      match /rooms/{roomId} {
        allow read:   if member(centerId);
        allow write:  if staff(centerId);
      }

      match /courses/{courseId} {
        allow read:   if member(centerId);
        allow write:  if staff(centerId);
      }

      match /groups/{groupId} {
        allow read:   if member(centerId);
        allow write:  if staff(centerId);
      }

      match /students/{studentId} {
        allow read:   if member(centerId);
        allow write:  if staff(centerId);
      }

      // Уроки: читают все member'ы, создают и обновляют учителя+, удаляют staff.
      match /lessons/{lessonId} {
        allow read:   if member(centerId);
        allow create: if teacher(centerId);
        allow update: if teacher(centerId);
        allow delete: if staff(centerId);
      }

      // Тесты: создают и редактируют учителя+, читают все member'ы.
      match /tests/{testId} {
        allow read:   if member(centerId);
        allow create: if teacher(centerId);
        allow update: if teacher(centerId);
        allow delete: if staff(centerId);
      }

      // Ответы на тесты: студент может создать свой ответ, читать — member'ы.
      // Обновлять (оценка) — учителя+, удалять — staff.
      match /testSubmissions/{submissionId} {
        allow read:   if member(centerId);
        allow create: if member(centerId);
        allow update: if teacher(centerId);
        allow delete: if staff(centerId);
      }

      // Финансы: студент видит свой баланс (фильтрация по studentId),
      // персонал видит все платежи. Пишет только персонал.
      match /payments/{paymentId} {
        allow read:  if staff(centerId)
                     || (member(centerId)
                         && resource.data.get('studentId', '') == uid());
        allow write: if staff(centerId);
      }
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Профили пользователей (верхний уровень, ключ {centerId}_{uid})
    // ═══════════════════════════════════════════════════════════════════════

    match /userProfiles/{docId} {
      // Свой профиль — всегда
      allow read: if signedIn() && resource.data.get('id', '') == uid();
      // Чужие — только внутри своего центра
      allow read: if signedIn() && member(resource.data.get('centerId', ''));
      // Отсутствующий документ: у него нет resource.data, поэтому оба правила выше
      // дают false и getDoc падает с permission-denied вместо пустого снапшота.
      // loadProfile перебирает ключи-кандидаты (platform_{uid}, {cid}_{uid}, {uid}),
      // и промах по любому из них обязан возвращать пустой результат.
      allow get: if signedIn() && resource == null;

      // Персонал заводит учеников и сотрудников — только в своём центре.
      // Закрыто: staff не может назначить role='owner' (только owner или platformAdmin).
      // Закрыто: docId ДОЛЖЕН совпадать с форматом {centerId}_{uid}.
      allow create: if staff(request.resource.data.get('centerId', ''))
                    && noPlatformFlags()
                    && isValidRole(request.resource.data.get('role', ''))
                    && (request.resource.data.get('role', '') != 'owner'
                        || owner(request.resource.data.get('centerId', '')))
                    && docId == (request.resource.data.get('centerId', '') + '_' + request.resource.data.get('id', ''));

      // Свой профиль создаётся легально в двух случаях:
      //  1) регистрация/восстановление владельца — ownerEmail центра совпадает с email;
      //  2) миграция легаси-профиля на композитный ключ — роль берётся из старого документа.
      // Закрыто: при миграции роль ДОЛЖНА совпадать с легаси-профилем.
      // Закрыто: при ownerEmail — роль должна быть 'owner'.
      allow create: if signedIn()
                    && request.resource.data.get('id', '') == uid()
                    && noPlatformFlags()
                    && isValidRole(request.resource.data.get('role', ''))
                    && docId == (request.resource.data.get('centerId', '') + '_' + uid())
                    && (
                         (hasLegacyIn(request.resource.data.get('centerId', ''))
                          && request.resource.data.get('role', '') == get(legacyPath()).data.role)
                         || (
                              exists(/databases/$(database)/documents/centers/$(request.resource.data.centerId))
                              && get(/databases/$(database)/documents/centers/$(request.resource.data.centerId))
                                   .data.get('ownerEmail', '') == request.auth.token.email
                              && request.resource.data.get('role', '') == 'owner'
                            )
                       );

      allow create: if platformAdmin();

      // Свой профиль можно править, но не повышать себе права.
      allow update: if signedIn()
                    && resource.data.get('id', '') == uid()
                    && noPrivilegeEscalation();

      // Персонал правит профили своего центра; перенос в другой центр и выдача
      // платформенных флагов запрещены. Staff не может повышать до owner.
      allow update: if staff(resource.data.get('centerId', ''))
                    && request.resource.data.get('centerId', '') == resource.data.get('centerId', '')
                    && noPlatformFlags()
                    && (request.resource.data.get('role', '') != 'owner'
                        || owner(resource.data.get('centerId', '')));

      allow update: if platformAdmin();

      allow delete: if platformAdmin() || owner(resource.data.get('centerId', ''));
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Сети филиалов
    // ═══════════════════════════════════════════════════════════════════════

    match /networks/{networkId} {
      allow read:   if platformUser()
                    || (signedIn()
                        && (resource.data.get('ownerId', '') == uid()
                            || hasProfileIn(resource.data.get('headquartersCenterId', ''))));
      allow create: if signedIn() && request.resource.data.get('ownerId', '') == uid();
      allow update, delete: if platformAdmin()
                            || (signedIn() && resource.data.get('ownerId', '') == uid());
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  Платформенные коллекции — читают все свои, пишет платформа
    // ═══════════════════════════════════════════════════════════════════════

    match /featureFlags/{flagId}        { allow read: if signedIn(); allow write: if platformAdmin(); }
    match /platformPlans/{planId}       { allow read: if signedIn(); allow write: if platformAdmin(); }
    match /platformNews/{newsId}        { allow read: if signedIn(); allow write: if platformUser(); }
    match /platformVersions/{versionId} { allow read: if signedIn(); allow write: if platformAdmin(); }
    match /platformCampaigns/{id}       { allow read, write: if platformUser(); }
    match /platformCoupons/{id}         { allow read: if signedIn(); allow write: if platformUser(); }

    // Платежи центров за подписку Ilmoz — центр видит только свои.
    match /platformPayments/{paymentId} {
      allow read:  if platformUser() || staff(resource.data.get('centerId', ''));
      allow write: if platformAdmin();
    }

    // Тикеты поддержки — свой центр либо платформа.
    match /supportTickets/{ticketId} {
      allow read:   if platformUser() || member(resource.data.get('centerId', ''));
      allow create: if signedIn();
      allow update: if platformUser() || staff(resource.data.get('centerId', ''));
      allow delete: if platformUser();
    }

    // Журнал аудита: дописывать можно (с валидацией), переписывать и стирать — нет.
    // userId ДОЛЖЕН совпадать с uid автора — нельзя подделать запись от чужого имени.
    match /auditLogs/{logId} {
      allow read:   if platformUser();
      allow create: if signedIn()
                    && request.resource.data.get('userId', '') == uid();
      allow update, delete: if false;
    }
  }
}
